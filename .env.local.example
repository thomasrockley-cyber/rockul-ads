# Vercel Postgres (Neon) — added automatically once you attach the Postgres
# storage integration to this project in the Vercel dashboard
DATABASE_URL=

# Vercel Blob — added automatically once you create a Blob store and
# connect it to this project
BLOB_READ_WRITE_TOKEN=

# The single password used to log in to this tool
ADMIN_PASSWORD=

# Random long strings — used to sign session cookies and unsubscribe links.
# Generate each with: openssl rand -hex 32
SESSION_SECRET=
CRON_SECRET=

# Resend — same account as Cash Comp is fine, just verify ads.rockul.com as
# a new domain there and use its own API key (or a shared one with access)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=ads@ads.rockul.com

NEXT_PUBLIC_SITE_URL=https://ads.rockul.com
