# Supabase — create a NEW project for this (kept separate from Cash Comp)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The single password used to log in to this tool
ADMIN_PASSWORD=

# Random long string — used to sign session cookies and unsubscribe links.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Resend — same account as Cash Comp is fine, just verify ads.rockul.com as
# a new domain there and use its own API key (or a shared one with access)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=ads@ads.rockul.com

# Shared secret Vercel Cron uses to call /api/cron/send-scheduled — generate
# with: openssl rand -hex 32
CRON_SECRET=

NEXT_PUBLIC_SITE_URL=https://ads.rockul.com
